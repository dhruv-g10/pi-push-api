# Server Bind Configuration
PI_PUSH_HOST=0.0.0.0
PI_PUSH_PORT=8000

# Base Upload Directory
# If relative, resolves against the server working directory.
# If absolute, files are stored under this path (e.g. /home/pi/uploads or ./uploads).
PI_PUSH_BASE_DIR=./uploads

# Allow Writing Outside Base Directory (Set to true to allow absolute paths anywhere on system)
PI_PUSH_ALLOW_ABSOLUTE_PATHS=true

# Command Execution Settings
PI_PUSH_ENABLE_EXEC=true
PI_PUSH_DEFAULT_EXEC_TIMEOUT=60
